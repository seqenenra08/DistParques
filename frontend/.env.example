# Archivo de ejemplo para variables de entorno del Frontend
# Copia este archivo y renómbralo a .env.local en la carpeta frontend/

# URL del backend Socket.IO
# En desarrollo (local):
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# En producción:
# NEXT_PUBLIC_SOCKET_URL=https://tu-backend.onrender.com

# Notas:
# - Asegúrate de NO incluir una barra final (/)
# - Usa http:// para desarrollo local
# - Usa https:// para producción
# - En Vercel, configura esto en: Settings → Environment Variables
